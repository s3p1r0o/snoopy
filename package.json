{
  "name": "@s3p1r0o/snoopy",
  "version": "0.1.0",
  "description": "Run DeepSeek Harness (dsh) against Rill Cloud's AI assistant in one command, through an embedded OpenAI-compatible proxy (localhost-only, ephemeral key).",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "ai-agent",
    "openai-compatible",
    "proxy",
    "rill",
    "llm",
    "cli"
  ],
  "homepage": "https://github.com/s3p1r0o/snoopy#readme",
  "bugs": {
    "url": "https://github.com/s3p1r0o/snoopy/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s3p1r0o/snoopy.git"
  },
  "author": "s3p1r0o",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "snoopy": "bin/launcher.js"
  },
  "scripts": {
    "harness": "node bin/harness.ts",
    "start": "npm run harness",
    "test": "node --test scripts/harness.test.ts",
    "postinstall": "node bin/postinstall.js"
  },
  "files": [
    "bin/launcher.js",
    "bin/postinstall.js",
    "lib/",
    "profile/"
  ],
  "dependencies": {
    "@deepseek-ai/dsh": "0.2.0-rc.2"
  },
  "engines": {
    "node": ">=20"
  },
  "os": [
    "linux",
    "darwin"
  ],
  "cpu": [
    "x64",
    "arm64"
  ]
}
